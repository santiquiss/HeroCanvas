{
  "name": "herocanvas",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src app proposals scripts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "proposal:code": "node --experimental-strip-types --no-warnings scripts/proposal-code.mjs",
    "persona:avatar": "node --experimental-strip-types --no-warnings scripts/persona-avatar.mjs",
    "shot": "node scripts/shot.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^18.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
